function renderItems(items, type){
  const intro = type==='ETF' ?
    `<div style="margin-bottom:20px">
      <div style="color:var(--accent);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Understanding ETFs</div>
      <div class="explain-box" style="background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.15)"><strong>An ETF (Exchange-Traded Fund) is like a shopping basket full of stocks.</strong> Instead of buying one company, you buy one share of the ETF and instantly own tiny pieces of 30-100+ companies. If one company in the basket has a bad day, the others help cushion the blow. ETFs trade on the stock market just like regular stocks — you can buy and sell them anytime the market is open. They're the safest way to invest in a theme (like defense or energy) without betting everything on one company.</div>
    </div>` :
    `<div style="margin-bottom:20px">
      <div style="color:var(--purple);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">Understanding Individual Stocks</div>
      <div class="explain-box" style="background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.2)"><strong>A stock is a tiny piece of ownership in one specific company.</strong> When you buy 1 share of Lockheed Martin, you literally own a sliver of Lockheed Martin. If the company does well, your share becomes worth more. If it does poorly, your share drops. Stocks are riskier than ETFs because you're betting on ONE company instead of a basket. But the flip side is: if you pick a winner, the returns can be much bigger. These 4 stocks were selected because they have the most DIRECT connection to specific provisions in the Big Beautiful Bill.</div>
    </div>`;

  return intro + `<div style="color:var(--dim);font-size:12px;margin-bottom:16px">Click any card to expand and see the full analysis, bill citations, and plain-English explanations.</div>` +
    items.map((it,idx)=>{
      const id=`${type}-${idx}`;
      const pills = type==='ETF' ?
        `${it.hold?`<div class="pill" style="background:rgba(255,255,255,.05)"><div class="pill-label">Top Holdings</div><div style="font-size:12px">${it.hold}</div></div>`:''}
         ${it.er?`<div class="pill" style="background:rgba(255,255,255,.05)"><div class="pill-label">Expense Ratio</div><div class="pill-val">${it.er}</div></div>`:''}
         ${it.ytd?`<div class="pill" style="background:rgba(255,255,255,.05)"><div class="pill-label">YTD Return</div><div class="pill-val" style="color:var(--green)">${it.ytd}</div></div>`:''}` :
        `${it.pe?`<div class="pill" style="background:rgba(255,255,255,.05)"><div class="pill-label">P/E Ratio</div><div class="pill-val">${it.pe}</div></div>`:''}
         ${it.div?`<div class="pill" style="background:rgba(255,255,255,.05)"><div class="pill-label">Dividend Yield</div><div class="pill-val">${it.div}</div></div>`:''}`;
      return `<div class="detail" id="${id}" style="border-left-color:${it.color}">
        <div class="detail-header" style="border-left-color:${it.color}" onclick="toggle('${id}')">
          <div class="detail-row">
            <div>
              <div style="display:flex;align-items:center;gap:10px;margin-bottom:6px">
                <span class="ticker mono" style="color:${it.color}">${it.ticker}</span>${badge(it.account)}<span style="color:var(--dim);font-size:11px">${type}</span>
              </div>
              <div style="font-size:14px;font-weight:500">${it.name}</div>
            </div>
            <div class="price mono">$${it.price}<div style="color:var(--dim);font-size:11px;font-weight:400">per share</div></div>
          </div>
          <div class="meta">
            <div><span>Risk </span>${dots(it.riskNum)}</div>
            <div><span>Shares: </span><strong>${it.shares}</strong></div>
            <div><span>Total: </span><strong style="color:var(--green)">$${it.cost.toLocaleString()}</strong></div>
            <div><span>Sell: </span><strong style="color:var(--accent)">${it.sell}</strong></div>
            <div><span>Sector: </span>${it.sector}</div>
            <span class="arrow">▾</span>
          </div>
        </div>
        <div class="detail-body" style="border-left-color:${it.color}">
          <div style="border-top:1px solid var(--border);padding-top:16px">
            <div class="section-title" style="color:var(--accent)">🎯 What is ${it.ticker}? (Plain English)</div>
            <div class="explain-box" style="background:rgba(245,158,11,.06)">${it.what}</div>
            <div class="section-title" style="color:var(--green)">💰 Why Buy? (The Money Thesis)</div>
            <div style="font-size:13px;line-height:1.8;margin-bottom:16px">${it.why}</div>
            <div class="section-title" style="color:var(--purple)">📜 Bill Citation</div>
            <div class="cite-box mono" style="background:rgba(139,92,246,.15)">${it.cite}</div>
            <div class="stat-pills">${pills}</div>
          </div>
        </div>
      </div>`;
    }).join('');
}

