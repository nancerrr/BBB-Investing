<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Big Beautiful Bill — Portfolio Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
--bg:#0a0e17;--card:#111827;--accent:#f59e0b;--green:#10b981;--red:#ef4444;--blue:#3b82f6;--purple:#8b5cf6;--cyan:#06b6d4;
--text:#e5e7eb;--dim:#9ca3af;--border:#1f2937;--white:#fff;
}
body{background:var(--bg);color:var(--text);font-family:'Outfit','Segoe UI',sans-serif;min-height:100vh;}
.mono{font-family:'JetBrains Mono',monospace;}
.wrap{max-width:920px;margin:0 auto;padding:24px 16px;}
h1{color:var(--white);font-size:28px;font-weight:800;line-height:1.2;text-align:center;}
h1 span{color:var(--accent);}
.subtitle{color:var(--dim);font-size:12px;text-align:center;margin-top:8px;}
.label{color:var(--accent);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:3px;text-align:center;margin-bottom:6px;}

/* Tabs */
.tabs{display:flex;gap:4px;background:var(--card);border-radius:12px;padding:4px;margin:24px 0;overflow-x:auto;}
.tab{flex:1;padding:10px 12px;border:none;border-radius:8px;cursor:pointer;font-family:inherit;font-size:12px;font-weight:500;color:var(--dim);background:transparent;white-space:nowrap;transition:.2s;}
.tab.active{background:var(--accent);color:var(--bg);font-weight:700;}

/* Cards */
.card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:20px;margin-bottom:16px;}
.card-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:16px;margin-bottom:24px;}
.stat-icon{font-size:24px;margin-bottom:8px;}
.stat-label{color:var(--dim);font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;}
.stat-val{font-size:26px;font-weight:700;}

/* Progress bars */
.pbar{width:100%;height:6px;background:var(--border);border-radius:3px;overflow:hidden;}
.pbar-fill{height:100%;border-radius:3px;transition:width .8s ease;}
.pbar-8{height:8px;border-radius:4px;}
.pbar-8 .pbar-fill{border-radius:4px;}

/* Account badge */
.badge{padding:3px 10px;border-radius:20px;font-size:11px;font-weight:600;letter-spacing:.5px;display:inline-block;}
.badge-brokerage{background:rgba(239,68,68,.15);color:#ef4444;}
.badge-roth{background:rgba(16,185,129,.15);color:#10b981;}
.badge-ira{background:rgba(59,130,246,.15);color:#3b82f6;}

/* Detail cards */
.detail{background:var(--card);border:1px solid var(--border);border-radius:12px;overflow:hidden;margin-bottom:16px;}
.detail-header{padding:20px;cursor:pointer;border-left:4px solid var(--blue);}
.detail-body{padding:0 20px 20px;border-left:4px solid var(--blue);display:none;}
.detail.open .detail-body{display:block;}
.detail-row{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;}
.ticker{font-size:22px;font-weight:800;}
.price{color:var(--white);font-size:20px;font-weight:700;text-align:right;}
.meta{display:flex;gap:16px;flex-wrap:wrap;align-items:center;font-size:12px;}
.meta span{color:var(--dim);}
.meta strong{color:var(--white);}
.arrow{color:var(--dim);font-size:18px;margin-left:auto;transition:transform .2s;}
.detail.open .arrow{transform:rotate(180deg);}
.section-title{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px;}
.explain-box{font-size:13px;line-height:1.8;padding:14px;border-radius:8px;margin-bottom:16px;}
.cite-box{font-size:12px;line-height:1.8;padding:14px;border-radius:8px;border-left:3px solid var(--purple);margin-bottom:16px;}
.stat-pills{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;}
.pill{padding:12px;border-radius:8px;}
.pill-label{color:var(--dim);font-size:10px;text-transform:uppercase;letter-spacing:1px;margin-bottom:4px;}
.pill-val{font-size:16px;font-weight:700;}

/* Risk dots */
.dots{display:flex;gap:3px;}
.dot{width:8px;height:8px;border-radius:50%;}

/* Split bar */
.split-bar{display:flex;height:32px;border-radius:8px;overflow:hidden;margin-bottom:16px;}
.split-bar div{display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--white);}

/* Bill bar */
.bill-row{margin-bottom:12px;}
.bill-row-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}

/* Account tab */
.acc-holdings{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}
.acc-chip{padding:8px 14px;border-radius:8px;display:flex;align-items:center;gap:8px;background:rgba(255,255,255,.05);}
.acc-rules{display:flex;gap:8px;flex-wrap:wrap;}
.rule{background:rgba(255,255,255,.03);padding:6px 12px;border-radius:6px;font-size:11px;color:var(--dim);}

/* Glossary */
.gloss{display:flex;gap:12px;background:var(--card);border:1px solid var(--border);border-radius:8px;padding:14px;margin-bottom:8px;}
.gloss-term{color:var(--accent);font-weight:700;min-width:120px;font-size:13px;}
.gloss-def{font-size:13px;line-height:1.6;}

/* Quiz */
.quiz-opt{background:rgba(255,255,255,.03);border:1px solid var(--border);border-radius:8px;padding:12px 16px;cursor:pointer;font-size:13px;margin-bottom:8px;transition:.2s;}
.quiz-opt:hover{border-color:var(--purple);}
.quiz-opt.correct{background:rgba(16,185,129,.15);border-color:var(--green);}
.quiz-opt.wrong{background:rgba(239,68,68,.15);border-color:var(--red);}
.quiz-opt.disabled{pointer-events:none;}
.btn{padding:10px 24px;background:var(--purple);color:var(--white);border:none;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px;font-family:inherit;margin-top:16px;}

/* Guide */
.guide-hero{background:linear-gradient(135deg,rgba(245,158,11,.1),rgba(139,92,246,.1));border:1px solid rgba(245,158,11,.2);border-radius:12px;padding:24px;margin-bottom:24px;}

.note-box{background:rgba(245,158,11,.06);border:1px solid rgba(245,158,11,.2);border-radius:12px;padding:20px;}
.note-title{font-size:13px;color:var(--accent);font-weight:700;margin-bottom:8px;}
.note-text{font-size:12px;color:var(--dim);line-height:1.7;}

.two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:24px;}
@media(max-width:640px){.two-col{grid-template-columns:1fr;}}

.hidden{display:none;}
</style>
</head>
<body>
<div class="wrap">
  <div class="label">Investment Strategy</div>
  <h1>Big Beautiful Bill<br><span>Portfolio Dashboard</span></h1>
  <div class="subtitle">Public Law 119-21 · Signed July 4, 2025 · $15,000 Portfolio</div>

