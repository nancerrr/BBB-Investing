  return `
  <div style="margin-bottom:20px;background:rgba(245,158,11,.06);padding:16px;border-radius:8px;border:1px solid rgba(245,158,11,.15)">
    <div style="color:var(--accent);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:1px;margin-bottom:8px">🧠 Why Account Type Matters</div>
    <div style="font-size:13px;line-height:1.8">Where you PUT an investment matters just as much as WHAT you invest in. The same stock can make you thousands more (or less) depending on which account it sits in. We matched each pick to the account where it creates the most value based on your goals, tax situation, and timeline.</div>
  </div>
  ${accounts.map(acc=>{
    const items=all.filter(i=>i.account===acc.name);
    const total=items.reduce((s,i)=>s+i.cost,0);
    return `<div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:12px">
        <div><span style="font-size:24px">${acc.icon}</span><span style="color:var(--white);font-size:18px;font-weight:700;margin-left:8px">${acc.name}</span></div>
        <span style="color:${acc.color};font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:1px">${acc.strat}</span>
      </div>
      <div style="font-size:13px;line-height:1.8;margin-bottom:16px">${acc.exp}</div>
      <div class="acc-holdings">${items.map(i=>`<div class="acc-chip"><span class="mono" style="color:${i.color};font-weight:700;font-size:13px">${i.ticker}</span><span style="color:var(--dim);font-size:11px">${i.shares} shares</span><span style="color:var(--green);font-weight:600;font-size:12px">$${i.cost.toLocaleString()}</span></div>`).join('')}</div>
      <div class="acc-rules">${acc.rules.map(r=>`<div class="rule">✓ ${r}</div>`).join('')}</div>
      <div style="margin-top:12px">
        <div style="display:flex;justify-content:space-between;font-size:12px;margin-bottom:4px"><span style="color:var(--dim)">Account Total</span><span class="mono" style="color:${acc.color};font-weight:700">$${total.toLocaleString()}</span></div>
        ${pbar(total,15000,acc.color,8)}
      </div>
    </div>`;
  }).join('')}`;
}

function renderLearn(){
  const glossary=[
    {t:"ETF",d:"A basket of stocks you can buy as a single investment. Like a variety pack instead of a single candy bar."},
    {t:"Expense Ratio",d:"The annual fee the ETF charges. 0.38% means you pay $3.80/year per $1,000 invested. Lower is better."},
    {t:"P/E Ratio",d:"Price-to-Earnings. Shows how much you pay for $1 of profit. Lower = cheaper, but growth stocks often have high P/E."},
    {t:"Dividend Yield",d:"Cash the company pays you just for owning the stock. 2% means you get $2/year for every $100 invested."},
    {t:"Capital Gains Tax",d:"Tax you pay when you sell an investment for a profit. 15% if you held it over 1 year, higher if less."},
    {t:"Backlog",d:"Orders a company has received but hasn't delivered yet. A $194B backlog (like LMT) means years of guaranteed revenue."},
    {t:"Appropriation",d:"When Congress officially allocates money for a specific purpose. The bill 'appropriates' billions to defense, energy, etc."},
    {t:"Attritable",d:"Military term for weapons designed to be expendable/disposable. Cheap drones you can afford to lose in battle."},
  ];
  const quizzes=[
    {q:"What does ETF stand for?",opts:["Extra Trading Fund","Exchange-Traded Fund","Electronic Trade Format","Equity Trust Fund"],c:1},
    {q:"Why did we put high-growth stocks in the Roth IRA?",opts:["Because it's required by law","Because gains grow tax-free forever","Because Roth has lower fees","Because it's faster to trade"],c:1},
    {q:"Section 20002 of the bill spends $30B+ on what?",opts:["Border wall construction","NASA missions to Mars","Navy shipbuilding programs","Cybersecurity infrastructure"],c:2},
    {q:"What's the main advantage of an ETF over a single stock?",opts:["ETFs are always cheaper","ETFs spread risk across many companies","ETFs never lose value","ETFs pay higher dividends"],c:1},
    {q:"Why is XLE in the Brokerage account instead of IRA?",opts:["XLE doesn't fit in an IRA","Energy is a short-term play to sell by May 2027","The IRA was full","XLE has no tax benefits"],c:1},
    {q:"How much does the bill appropriate for border wall infrastructure?",opts:["$10 billion","$25 billion","$46.5 billion","$100 billion"],c:2},
  ];

  return `
  <div style="margin-bottom:24px">
    <h3 style="color:var(--accent);font-size:16px;font-weight:700;margin-bottom:8px">📚 Key Concepts Glossary</h3>
    ${glossary.map(g=>`<div class="gloss"><span class="gloss-term mono">${g.t}</span><span class="gloss-def">${g.d}</span></div>`).join('')}
  </div>
  <div class="card" style="padding:24px">
    <h3 style="color:var(--purple);font-size:16px;font-weight:700;margin-bottom:4px">🧪 Test Your Knowledge</h3>
    <div style="color:var(--dim);font-size:12px;margin-bottom:16px" id="quiz-counter">Question 1 of ${quizzes.length}</div>
    <div id="quiz-progress">${pbar(1,quizzes.length,'var(--purple)',4)}</div>
    <div style="color:var(--white);font-size:15px;font-weight:600;margin:20px 0 16px" id="quiz-q"></div>
    <div id="quiz-opts"></div>
    <div id="quiz-btn-wrap"></div>
  </div>`;
}

let quizIdx=0,quizAnswer=null;
const quizzes=[
  {q:"What does ETF stand for?",opts:["Extra Trading Fund","Exchange-Traded Fund","Electronic Trade Format","Equity Trust Fund"],c:1},
  {q:"Why did we put high-growth stocks in the Roth IRA?",opts:["Because it's required by law","Because gains grow tax-free forever","Because Roth has lower fees","Because it's faster to trade"],c:1},
  {q:"Section 20002 of the bill spends $30B+ on what?",opts:["Border wall construction","NASA missions to Mars","Navy shipbuilding programs","Cybersecurity infrastructure"],c:2},
  {q:"What's the main advantage of an ETF over a single stock?",opts:["ETFs are always cheaper","ETFs spread risk across many companies","ETFs never lose value","ETFs pay higher dividends"],c:1},
  {q:"Why is XLE in the Brokerage account instead of IRA?",opts:["XLE doesn't fit in an IRA","Energy is a short-term play to sell by May 2027","The IRA was full","XLE has no tax benefits"],c:1},
  {q:"How much does the bill appropriate for border wall infrastructure?",opts:["$10 billion","$25 billion","$46.5 billion","$100 billion"],c:2},
];

function loadQuiz(){
  const qz=quizzes[quizIdx];
  document.getElementById('quiz-counter').textContent=`Question ${quizIdx+1} of ${quizzes.length}`;
  document.getElementById('quiz-progress').innerHTML=pbar(quizIdx+1,quizzes.length,'var(--purple)',4);
  document.getElementById('quiz-q').textContent=qz.q;
  document.getElementById('quiz-opts').innerHTML=qz.opts.map((o,i)=>`<div class="quiz-opt" id="qo-${i}" onclick="pickAnswer(${i})">${String.fromCharCode(65+i)}. ${o}</div>`).join('');
  document.getElementById('quiz-btn-wrap').innerHTML='';
  quizAnswer=null;
}
function pickAnswer(i){
  if(quizAnswer!==null)return;
  quizAnswer=i;
  const qz=quizzes[quizIdx];
  for(let j=0;j<qz.opts.length;j++){
    const el=document.getElementById('qo-'+j);
    el.classList.add('disabled');
    if(j===qz.c)el.classList.add('correct'),el.innerHTML+=' ✅';
    if(j===i&&i!==qz.c)el.classList.add('wrong'),el.innerHTML+=' ❌';
  }
  document.getElementById('quiz-btn-wrap').innerHTML=`<button class="btn" onclick="nextQuiz()">${quizIdx<quizzes.length-1?'Next Question →':'Start Over 🔄'}</button>`;
}
function nextQuiz(){quizIdx=(quizIdx+1)%quizzes.length;loadQuiz();}

function renderGuide(){
  const sections=[
    {t:"🎯 Dashboard Tab",c:"Your command center. See your total budget ($15,000), how it's allocated across accounts, the ETF/stock split, and a visual breakdown of where the bill spends money. The spending bars show you the relative scale of each sector's funding — defense dwarfs everything else, which is why defense-related investments dominate the portfolio."},
    {t:"📊 ETFs Tab",c:"Click any ETF card to expand it. Each card has three key sections: (1) 'What is it?' explains the ETF in plain language, (2) 'Why Buy?' explains the investment case tied to the bill, and (3) 'Bill Citation' gives you the exact sections and dollar amounts from Public Law 119-21. The colored stats at the bottom show expense ratios, returns, and holdings at a glance."},
    {t:"📈 Stocks Tab",c:"Same expandable format as ETFs but for individual companies. These 4 stocks were chosen because they have the MOST DIRECT connection to specific bill provisions. HII is the only company that builds certain Navy ships. PLTR is the military's go-to AI platform. Each card explains this connection in plain English and cites the exact sections."},
    {t:"💼 Account Plan Tab",c:"This is crucial — it explains WHY each investment goes in a specific account type. The strategy: high-growth picks go in Roth IRA (tax-free growth), short-term trades go in Brokerage (sell by May 2027), and steady dividend payers go in Traditional IRA (tax-deferred compounding). Each account section shows its holdings, rules, and total allocation."},
    {t:"📚 Learn Tab",c:"A glossary of every financial term used in this dashboard, plus an interactive quiz to test your understanding. The quiz covers both investment concepts and bill-specific knowledge. Great for reinforcing what you've learned — try to get all 6 questions right!"},
    {t:"🔄 How to Actually Buy",c:"1. Log into your brokerage platform (Fidelity, Schwab, Vanguard, etc.). 2. Navigate to the correct account (Brokerage, Roth IRA, or IRA). 3. Search for the ticker symbol (e.g., 'ITA'). 4. Select 'Buy' and enter the number of shares from this dashboard. 5. Use a 'Limit Order' set slightly above the current price to control your purchase price. 6. Review and confirm. Repeat for each position in the correct account."},
    {t:"⏰ When to Sell",c:"Brokerage positions (XLE, XOP, KTOS): Target May 2027. Set price alerts on your brokerage at +30% and +50% from your purchase price. If energy/defense momentum fades before May 2027, consider selling earlier. Roth IRA and IRA positions: These are long-term holds. The defense spending authorized by this bill runs through September 30, 2029. Space and AI spending runs even longer. Let these compound for 5+ years minimum."},
    {t:"⚠️ Risk Management",c:"The ~$1,254 cash reserve is intentional — it gives you flexibility to buy more if prices dip, or to cover any emergencies. Never invest money you might need in the next 6 months. If any single position drops 25%+, don't panic sell — review whether the bill's funding provisions have changed. If the funding is still there, the thesis is still intact."},
  ];
  return `
  <div class="guide-hero">
    <h3 style="color:var(--white);font-size:18px;font-weight:700;margin-bottom:12px">📖 How to Use This Dashboard</h3>
    <div style="font-size:13px;line-height:1.8">This tool was built to help you make informed investment decisions based on specific government spending provisions in the Big Beautiful Bill (Public Law 119-21). Here's how to get the most out of it.</div>
  </div>
  ${sections.map(s=>`<div class="card"><h4 style="color:var(--white);font-size:14px;font-weight:700;margin-bottom:10px">${s.t}</h4><div style="font-size:13px;line-height:1.8">${s.c}</div></div>`).join('')}`;
}

function toggle(id){document.getElementById(id).classList.toggle('open');}

function showTab(idx){
  document.querySelectorAll('.tab').forEach((t,i)=>{t.classList.toggle('active',i===idx);});
  const el=document.getElementById('tab-content');
  if(idx===0) el.innerHTML=renderDashboard();
  else if(idx===1) el.innerHTML=renderItems(D.etfs,'ETF');
  else if(idx===2) el.innerHTML=renderItems(D.stocks,'STOCK');
  else if(idx===3) el.innerHTML=renderAccountPlan();
  else if(idx===4){el.innerHTML=renderLearn();loadQuiz();}
  else if(idx===5) el.innerHTML=renderGuide();
}
showTab(0);
</script>
</body>
</html>
