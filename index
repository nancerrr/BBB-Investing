function badge(acc){
  if(acc==="Brokerage") return `<span class="badge badge-brokerage">📈 Brokerage</span>`;
  if(acc==="Roth IRA") return `<span class="badge badge-roth">🌱 Roth IRA</span>`;
  return `<span class="badge badge-ira">🏦 IRA</span>`;
}
function dots(n){
  let h='<span class="dots">';
  for(let i=1;i<=5;i++){
    let c=n<=2?'var(--green)':n<=3?'var(--accent)':'var(--red)';
    h+=`<span class="dot" style="background:${i<=n?c:'var(--border)'}"></span>`;
  }
  return h+'</span>';
}
function pbar(val,max,color,h){
  let cls=h>6?'pbar pbar-8':'pbar';
  return `<div class="${cls}"><div class="pbar-fill" style="width:${(val/max)*100}%;background:${color};"></div></div>`;
}

